{
  "name": "frontend",
  "version": "0.0.21",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn type-check &&vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:coverage": "E2E_COVERAGE=true vite build --mode development && start-server-and-test preview http://localhost:4173 'cypress run --e2e' ; node scripts/e2e-coverage-report.mjs && nyc report",
    "test:e2e:dev": "start-server-and-test 'vite --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:e2e:demo": "cypress run --e2e --config-file cypress.demo.config.ts",
    "cypress:open": "npx cypress open --e2e --config baseUrl=http://localhost:5173",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint . ",
    "lint:fix": "eslint .  --fix ",
    "format": "prettier --cache --check src/",
    "format:fix": "prettier --cache --check src/ --write",
    "lintformat:fix": "yarn lint:fix && yarn format:fix",
    "depcheck": "depcheck",
    "update-version": "npm version patch --no-git-tag-version && yarn install --silent && node ./scripts/create-branch.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@sentry/vue": "^11.18.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/devtools-api": "^8.2.1",
    "@vuepic/vue-datepicker": "^14.1.0",
    "@vueuse/core": "^15.1.0",
    "axios": "^1.21.1",
    "chart.js": "^4.6.2",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.2",
    "keycloak-js": "^26.2.5",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^5.3.0",
    "pinia": "^4.1.0",
    "qr-code-styling": "^1.9.2",
    "qr-scanner": "1.4.2",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "vue-leaflet-markercluster": "^0.6.1",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.11",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.7.0",
    "cypress": "16.4.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.2.0",
    "eslint-plugin-vue": "^10.12.1",
    "istanbul-lib-coverage": "^3.2.2",
    "jsdom": "^31.0.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "nyc": {
    "report-dir": "coverage-e2e",
    "reporter": [
      "text-summary",
      "html",
      "lcov",
      "json-summary"
    ],
    "temp-dir": ".nyc_output",
    "extension": [
      ".ts",
      ".vue"
    ],
    "all": false
  }
}
